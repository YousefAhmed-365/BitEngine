{
  "style_sheet": "res/ui/ui_neon_noir_style.json",

  "elements": [

    {
      "id":            "dialog_root",
      "type":          "group",
      "bind_visible":  "var.ui_visible", 
      "anchor_to":     "screen",
      "anchor_point":  "bottom-center",
      "offset":        [0, -20],
      "size":          { "w": "94%", "h": 180 },
      "children": [
        {
          "id":           "dialog_box",
          "type":         "panel",
          "style":        "dialog_panel",
          "anchor_point": "fill"
        },
        {
          "id":           "name_label_box",
          "type":         "panel",
          "role":         "name_label",
          "bind_visible": "var.entity_name",
          "bind_content": "var.entity_name",
          "style":        "name_panel",
          "anchor_point": "top-left",
          "offset":       [30, -22],
          "size":         { "w": "auto", "h": 40 },
          "padding":      [0, 20, 0, 20],
          "children": [
            {
              "id":           "name_text",
              "type":         "text",
              "bind_content": "var.entity_name",
              "style":        "name_text_style",
              "anchor_point": "fill"
            }
          ]
        },
        {
          "id":           "dialog_text",
          "type":         "rich_text",
          "role":         "dialog_text",
          "bind_content": "var.dialog",
          "style":        "dialog_text_style",
          "anchor_point": "top-left",
          "padding":      [40, 40, 20, 40]
        },
        {
          "id":           "dialog_cursor",
          "type":         "cursor",
          "role":         "dialog_cursor",
          "bind_visible": "var.is_waiting_input",
          "style":        "cursor_style",
          "anchor_point": "bottom-right",
          "offset":       [-18, -14],
          "animations": [
            {
              "type": "pulse",
              "target": "opacity",
              "speed": 10.0,
              "min": 0.2,
              "max": 1.0
            }
          ]
        }
      ]
    },

    {
      "id":           "choice_container",
      "type":         "group",
      "role":         "choice_list",
      "bind_visible": "var.choices_visible",
      "style":        "choice_panel",
      "anchor_to":    "screen",
      "anchor_point": "center",
      "offset":       [0, -80],
      "size":         { "w": 450, "h": "auto" },
      "padding":      [10, 10, 10, 10],
      "bind_items":   "var.choices",
      "item_template": {
        "type":         "button",
        "role":         "choice_item",
        "bind_content": "$item.text",
        "style":        "choice_button",
        "anchor_point": "top-center",
        "size":         { "w": "100%" }
      }
    },

    {
      "id":           "toast_panel",
      "type":         "panel",
      "role":         "toast",
      "style":        "toast_style",
      "anchor_to":    "screen",
      "anchor_point": "top-right",
      "offset":       [-20, 20],
      "size":         { "w": 200, "h": 40 }
    },

    {
      "id":           "history_panel",
      "type":         "group",
      "role":         "history_panel",
      "style":        "history_style",
      "anchor_to":    "screen",
      "anchor_point": "fill",
      "visible":      true
    },

    {
      "id":           "mouse_cursor",
      "type":         "image",
      "role":         "mouse_cursor",
      "style":        "mouse_cursor_style",
      "anchor_to":    "screen",
      "anchor_point": "top-left"
    }
  ]
}
